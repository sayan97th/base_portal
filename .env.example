NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — use test keys for local development, live keys for production
# Get your keys at https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Calendly — generic fallback used when a page-specific variable is not set
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/30min"

# Per-page Calendly URLs (leave empty to fall back to NEXT_PUBLIC_CALENDLY_URL)
NEXT_PUBLIC_CALENDLY_URL_PREMIUM_MENTIONS=
NEXT_PUBLIC_CALENDLY_URL_SEO_PACKAGES=
NEXT_PUBLIC_CALENDLY_URL_SME_AUTHORED=
NEXT_PUBLIC_CALENDLY_URL_SME_ENHANCED=
NEXT_PUBLIC_CALENDLY_URL_SME_COLLABORATION=

# Laravel Reverb (WebSocket) — replace with real values in production
NEXT_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
